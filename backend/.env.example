APP_ENV=development
APP_VERSION=1.0.0

# Application runtime connection — the cabio_app role, RLS-enforced.
DATABASE_URL=postgresql://cabio_app:password@localhost:54322/postgres
# Table-owner connection, used only by Alembic for DDL (cabio_app has no
# CREATE/ALTER grants). See docs/Backend-Implementation-Standards.md §12.
ADMIN_DATABASE_URL=postgresql://postgres:password@localhost:54322/postgres
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# One-time bootstrap value, only read by migration 0008 to create the
# cabio_app role's login password. Not needed for normal app runtime.
CABIO_APP_DB_PASSWORD=

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

LOG_LEVEL=INFO

CORS_ORIGINS=["http://localhost:5173"]
